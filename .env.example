# ShareVibe frontend environment placeholders
# Copy to .env.local for local development. Never commit real .env files.

# Firebase public web client config. These are public client identifiers, not server secrets.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-web-app-id

# Environment
VITE_ENV=development
VITE_API_URL=http://localhost:3001
VITE_EMAIL_API_BASE=http://localhost:3001

# Client-only UI hints. Do not use these as authoritative authorization.
VITE_SUPER_ADMIN_EMAILS=

# Central access policy source is config/access/policy.json.
# Optional runtime fallback, comma-separated. Do not put passwords or tokens here.
SHAREVIBE_SUPER_OWNER_EMAILS=
SHAREVIBE_BOOTSTRAP_SUPER_OWNER_EMAILS=
SHAREVIBE_ACCESS_SETUP_SUPER_OWNERS=
SHAREVIBE_ACCESS_SETUP_OWNER_EMAILS=
SHAREVIBE_ACCESS_SETUP_OWNER_CAFES=
SHAREVIBE_ACCESS_SETUP_MANAGER_EMAILS=
SHAREVIBE_ACCESS_SETUP_MANAGER_CAFES=
SHAREVIBE_ACCESS_SETUP_DRY_RUN=0
SHAREVIBE_ACCESS_SYNC_DRY_RUN=0

# Optional error tracking and analytics
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false

# App limits exposed to the browser
VITE_MAX_UPLOAD_SIZE=8000000
VITE_MAX_IMAGE_WIDTH=4096
VITE_MAX_IMAGE_HEIGHT=4096
VITE_MAX_WEEKLY_UPLOADS=2
VITE_MEDIA_RETENTION_DAYS=7

# Firestore rule generation allowlists. Prefer Firebase custom claims in production.
FIREBASE_SUPER_ADMIN_EMAILS=
FIREBASE_OWNER_ACCESS_EMAILS=

# [SV-05] Firebase App Check — ReCaptcha Enterprise
# The site key is a public client identifier (not a secret).
# The debug token is only used in development environments.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-recaptcha-enterprise-site-key
VITE_APPCHECK_DEBUG_TOKEN=

# [SV-14] Security notes:
# - Only VITE_ prefixed variables are bundled into the client build.
# - Never add server secrets, API tokens, or database URLs with VITE_ prefix.
# - Run `npm run security:audit` regularly to check for high/critical vulnerabilities.
