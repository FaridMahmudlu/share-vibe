{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=localhost",
    "build": "vite build && node scripts/maintenance/generate-static-public-pages.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts ShareVibeExplainer out/sharevibe-explainer.mp4",
    "remotion:still": "remotion still src/remotion/index.ts ShareVibeExplainer out/sharevibe-explainer-frame.png --frame=300 --scale=0.25",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "access:setup": "node scripts/access/setup-access-policy.mjs",
    "access:setup:dry": "node scripts/access/setup-access-policy.mjs --dry-run --non-interactive",
    "access:bootstrap": "node scripts/access/bootstrap-super-owner.mjs",
    "access:sync-claims": "node scripts/access/sync-firebase-claims.mjs",
    "access:sync-claims:dry": "node scripts/access/sync-firebase-claims.mjs --dry-run",
    "generate:access-policy": "node scripts/maintenance/generate-access-policy.mjs",
    "generate:rules": "node scripts/firebase/generate-firestore-rules.mjs",
    "generate:sitemaps": "node scripts/maintenance/generate-sitemaps.mjs",
    "deploy:hosting": "node scripts/firebase/firebase-deploy.mjs hosting",
    "deploy:rules": "node scripts/firebase/firebase-deploy.mjs rules",
    "deploy:prod": "npm run build && node scripts/firebase/firebase-deploy.mjs prod",
    "deploy:check": "node scripts/deploy/check-deploy-env.js",
    "deploy:discover": "node scripts/deploy/discover-production-path.js",
    "deploy:health": "node scripts/deploy/health-check.js",
    "deploy:production": "node scripts/deploy/deploy-production.js",
    "security:audit": "npm audit --omit=dev --audit-level=high && npm --prefix backend audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.452",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "exifreader": "^4.41.0",
    "jsdom": "^29.1.0",
    "remotion": "^4.0.452",
    "tailwindcss": "^4.1.14",
    "terser": "^5.46.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.5"
  }
}
