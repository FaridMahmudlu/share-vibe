DATABASE_URL=your-postgres-connection-url
REDIS_URL=redis://localhost:6379
BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER=no-reply@mail.sharevibe.co
EMAIL_SENDER_NAME=ShareVibe
BREVO_SANDBOX_MODE=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_WEBHOOK_TOKEN=replace-with-random-webhook-token
GLOBAL_DAILY_LIMIT=280
PER_CAFE_DAILY_LIMIT=50
PER_CAMPAIGN_LIMIT=50
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://sharevibe.co,https://www.sharevibe.co
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
BACKEND_SUPER_ADMIN_EMAILS=
SHAREVIBE_SUPER_OWNER_EMAILS=
SHAREVIBE_CAFE_ACCESS_JSON=[]
BACKEND_CAFE_ACCESS_JSON=[]
ALLOW_UNVERIFIED_DEV_AUTH=false
