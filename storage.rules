rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ═══════════════════════════════════════════════════════════════
    // STORAGE SECURITY RULES FOR SHARE VIBE
    // ═══════════════════════════════════════════════════════════════
    // 
    // Storage hierarchy:
    // /media/{cafeSlug}/{mediaId}.{ext}
    //
    // Access rules:
    // - READ: Public gallery media
    // - WRITE: Authenticated users only, scoped to a cafe slug
    // - DELETE: Only uploader or admin can delete
    // ═══════════════════════════════════════════════════════════════

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUploader() {
      return isAuthenticated() && request.auth.uid == resource.metadata.uploaderUid;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             (
               request.auth.token.sharevibeSuperOwner == true ||
               request.auth.token.role == "super_owner"
             );
    }

    function canManageCafe(cafeSlug) {
      return isSuperAdmin() ||
             (
               request.auth.token.sharevibeOwnerCafes is list &&
               cafeSlug in request.auth.token.sharevibeOwnerCafes
             ) ||
             (
               request.auth.token.sharevibeManagerCafes is list &&
               cafeSlug in request.auth.token.sharevibeManagerCafes
             ) ||
             (
               request.auth.token.role in ["owner", "manager"] &&
               request.auth.token.cafeIds is list &&
               cafeSlug in request.auth.token.cafeIds
             );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    function isValidImageType(contentType) {
      return contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/heic'
      ];
    }

    function isValidFileSize() {
      // Max 15MB
      return request.resource.size <= 15000000;
    }

    function hasAllowedImageExtension(fileName) {
      return fileName.matches('(?i)^.+\\.(jpg|jpeg|png|webp|heic)$');
    }

    function isValidMetadata() {
      let meta = request.resource.metadata;
      return meta.uploaderUid == request.auth.uid &&
             meta.uploadedAt is string &&
             meta.uploadedAt.size() > 0 &&
             meta.cafeSlug is string &&
             meta.cafeSlug.size() > 0;
    }

    // ─────────────────────────────────────────────────────────────────
    // MEDIA FILES: /media/{cafeSlug}/{mediaId}.{ext}
    // ─────────────────────────────────────────────────────────────────
    match /media/{cafeSlug}/{mediaId} {
      
      // Deny public read, allow only uploader or cafe administrator/super admin
      allow read: if isAuthenticated() && (isUploader() || canManageCafe(cafeSlug) || isSuperAdmin());

      // UPLOAD: Authenticated users only
      allow create: if
        isAuthenticated() &&
        hasAllowedImageExtension(mediaId) &&
        isValidImageType(request.resource.contentType) &&
        isValidFileSize() &&
        isValidMetadata() &&
        request.resource.metadata.cafeSlug == cafeSlug;

      // UPDATE: Not allowed (media immutable)
      allow update: if false;

      // DELETE: Uploader or admin only
      allow delete: if
        isUploader() || canManageCafe(cafeSlug);
    }

    // ─────────────────────────────────────────────────────────────────
    // CAMPAIGN FILES: /campaigns/{cafeSlug}/{fileName}
    // ─────────────────────────────────────────────────────────────────
    match /campaigns/{cafeSlug}/{fileName} {
      allow read: if true;

      allow create: if
        canManageCafe(cafeSlug) &&
        hasAllowedImageExtension(fileName) &&
        isValidImageType(request.resource.contentType) &&
        isValidFileSize();

      allow update: if false;
      allow delete: if canManageCafe(cafeSlug);
    }

    // ─────────────────────────────────────────────────────────────────
    // ADMIN FILES: /admin/{adminId}/{fileName}
    // ─────────────────────────────────────────────────────────────────
    match /cafes/{cafeSlug}/settings/{fileName} {
      allow read: if true;

      allow create: if
        canManageCafe(cafeSlug) &&
        hasAllowedImageExtension(fileName) &&
        isValidImageType(request.resource.contentType) &&
        request.resource.size <= 4000000 &&
        isValidMetadata() &&
        request.resource.metadata.cafeSlug == cafeSlug &&
        request.resource.metadata.purpose == 'cafe-logo';

      allow update: if false;
      allow delete: if isUploader() || canManageCafe(cafeSlug);
    }

    match /admin/{adminId}/{fileName} {
      
      allow read: if isSuperAdmin() && request.auth.uid == adminId;
      allow write: if isSuperAdmin() && request.auth.uid == adminId;
      allow delete: if isSuperAdmin() && request.auth.uid == adminId;
    }

    // ─────────────────────────────────────────────────────────────────
    // DEFAULT: DENY ALL
    // ─────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
