# ShareVibe production deployment placeholders.
# Copy to .deploy.env locally if needed. Never commit .deploy.env.

SHAREVIBE_DEPLOY_HOST=your-server-host
SHAREVIBE_DEPLOY_PORT=22
SHAREVIBE_DEPLOY_USER=deploy

# Prefer SSH key authentication.
SHAREVIBE_DEPLOY_SSH_KEY_PATH=C:\path\to\deploy_key

# Optional fallback only if key auth is not available.
SHAREVIBE_DEPLOY_PASSWORD=

# Temporary emergency bootstrap only. Keep empty for normal production deployment.
SHAREVIBE_ALLOW_ROOT_BOOTSTRAP=

# Optional initially. If omitted, npm run deploy:discover will try read-only discovery.
SHAREVIBE_DEPLOY_PATH=

SHAREVIBE_DEPLOY_HEALTH_URL=https://sharevibe.co
